:root{--bg:#090a18;--panel:#111328;--panel2:#171a34;--line:#2b2f52;--text:#f7f7ff;--muted:#9ca1bd;--pink:#ff62bd;--purple:#8d5cff;--blue:#5b9cff;--glow:0 15px 40px rgba(88,56,180,.22)}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 48% 0,#282456 0,transparent 30%),linear-gradient(180deg,#0b0c1f,#070812 70%);color:var(--text);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea{font:inherit}button{cursor:pointer;color:inherit}.layout{display:grid;grid-template-columns:230px minmax(600px,1fr) 270px;gap:18px;max-width:1540px;margin:auto;padding:14px 18px 30px}.sidebar,.rightbar{min-height:calc(100vh - 28px)}.sidebar{position:sticky;top:14px;height:calc(100vh - 28px);padding:4px 10px;border-right:1px solid var(--line);display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:10px;margin-bottom:20px}.brand img{width:62px;height:62px;border-radius:22px;object-fit:cover}.brand h1{margin:0;font-size:28px;letter-spacing:-1px}.brand p{margin:2px 0 0;color:var(--muted);font-size:12px}.nav{display:grid;gap:7px}.nav button{border:1px solid transparent;background:transparent;text-align:left;padding:13px 14px;border-radius:16px;color:#c8cae2;font-weight:650}.nav button.active{background:linear-gradient(135deg,#8b5cf6,#ff61bc);border-color:#b879ff;box-shadow:var(--glow);color:#fff}.nav .ico{display:inline-block;width:28px;font-size:21px}.nav-title{margin:24px 12px 8px;color:#858bad;font-size:12px;text-transform:uppercase;letter-spacing:1px}.mini-mascot{margin-top:auto;text-align:center;padding:12px 0}.mini-mascot img{width:100%;max-height:210px;object-fit:cover;object-position:center;border-radius:25px}.mini-mascot small{display:block;color:var(--muted);margin-top:7px}.topbar{display:flex;align-items:center;gap:12px;margin-bottom:12px}.search{flex:1;background:#13152b;border:1px solid #2a2d50;border-radius:18px;padding:14px 16px;color:#fff;outline:0}.round,.say{border:1px solid #34385d;background:#111329;border-radius:18px;padding:12px 16px;font-weight:700}.say{margin-left:auto;background:linear-gradient(135deg,#7f5bff,#ff5eb8);border:0;box-shadow:0 8px 25px #e34a9638}.hero{height:145px;border:1px solid #34345d;border-radius:25px;overflow:hidden;background:#262653 url('assets/hero.jpg') center/cover no-repeat;position:relative;box-shadow:var(--glow);padding:23px 28px}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,19,58,.96),rgba(20,19,58,.58),transparent)}.hero>*{position:relative;z-index:1}.hero h2{font-size:32px;margin:0 0 6px}.hero p{margin:0;color:#e1e1f3;line-height:1.55}.moods{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;margin:15px 0}.mood{height:108px;border:1px solid #34375d;border-radius:20px;background:#15182e;overflow:hidden;position:relative;padding:10px;display:flex;align-items:end;font-weight:750;box-shadow:var(--glow)}.mood:before{content:"";position:absolute;inset:0;background:var(--img) center/cover no-repeat;opacity:.95}.mood:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 35%,rgba(5,6,17,.88))}.mood span{z-index:1;text-shadow:0 2px 8px #000}.section-head{display:flex;align-items:center;justify-content:space-between;margin:12px 0}.section-head h2{margin:0;font-size:22px}.filters{display:flex;gap:8px}.filter{border:1px solid #2f3154;background:#111329;border-radius:16px;padding:10px 14px;color:#cfd1e8}.filter.active{background:linear-gradient(135deg,#7048e8,#ad4be4);color:#fff}.feed{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:start}.post{min-height:245px;border:1px solid #3b3d65;border-radius:22px;overflow:hidden;position:relative;background:#171a30;box-shadow:var(--glow);display:flex;flex-direction:column}.post.tall{min-height:315px}.post-bg{position:absolute;inset:0;background:center/cover no-repeat;opacity:.8}.post-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,8,19,.15),rgba(7,8,19,.55) 50%,rgba(7,8,19,.96))}.post-content{position:relative;z-index:1;padding:16px;display:flex;flex-direction:column;height:100%;min-height:inherit}.tag{align-self:flex-start;background:#252a48e6;border:1px solid #4a4f77;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:750}.quote{font-size:18px;font-weight:650;line-height:1.45;margin-top:13px;text-shadow:0 2px 8px #000}.post-actions{margin-top:auto;padding-top:16px;display:flex;gap:15px;color:#e8e8f5;font-size:13px}.post-actions button{border:0;background:transparent;padding:0;color:inherit}.post-actions button:hover{color:#ff8ed0}.adrow{grid-column:span 3;display:grid;grid-template-columns:1fr 1fr;gap:14px}.ad{height:112px;border:1px dashed #4c5070;border-radius:20px;background:linear-gradient(135deg,#161a33,#201b43);display:flex;align-items:center;justify-content:center;color:#9da2c0;font-size:12px;letter-spacing:1px}.rightbar{position:sticky;top:14px;height:max-content;display:grid;gap:16px}.panel{border:1px solid #2d3153;border-radius:22px;background:linear-gradient(180deg,#12152a,#0d0f20);padding:17px;box-shadow:var(--glow)}.panel h3{margin:0 0 14px;font-size:17px}.trend{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #252841}.trend:last-child{border:0}.trend img{width:43px;height:43px;border-radius:13px;object-fit:cover}.trend b{font-size:13px}.trend small{color:var(--muted);margin-left:auto}.talk{min-height:170px;background:linear-gradient(135deg,#31276b,#ec5ba8);position:relative;overflow:hidden}.talk:after{content:"";position:absolute;inset:0;background:url('assets/share.jpg') right center/cover no-repeat;opacity:.8}.talk>*{position:relative;z-index:1}.talk .bubble{background:#fff;color:#25253d;border-radius:22px;padding:12px;font-size:13px;width:70%}.chart{display:grid;grid-template-columns:120px 1fr;gap:12px;align-items:center}.donut{width:120px;height:120px;border-radius:50%;background:conic-gradient(#ff5ab5 0 34%,#8a70ff 34% 56%,#69b7df 56% 74%,#6c5aa8 74% 86%,#f3a444 86% 94%,#ffe04b 94% 100%);display:grid;place-items:center}.donut:after{content:"34%\A Lonely";white-space:pre;text-align:center;display:grid;place-items:center;width:80px;height:80px;border-radius:50%;background:#14162c;color:#fff;font-weight:800}.legend{font-size:12px;color:#c9cbe0;line-height:2}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px}.modal-back{position:fixed;inset:0;background:#02030bbd;display:grid;place-items:center;padding:16px;z-index:20}.modal{width:min(600px,100%);max-height:85vh;overflow:auto;background:#12152a;border:1px solid #41456d;border-radius:25px;padding:20px;box-shadow:0 30px 90px #000}.modal h2{margin-top:0}.textarea{width:100%;min-height:140px;border-radius:17px;border:1px solid #3a3d60;background:#0c0e1e;color:#fff;padding:14px;outline:none}.modal-actions{display:flex;gap:10px;margin-top:12px}.primary{border:0;border-radius:15px;padding:12px 16px;background:linear-gradient(135deg,#8057ff,#ff5db8);font-weight:800}.ghost{border:1px solid #3b3e62;border-radius:15px;padding:12px 16px;background:#171a30}.reply{padding:11px 0;border-bottom:1px solid #292c49;color:#d9dbea}.mobile-nav{display:none}@media(max-width:1200px){.layout{grid-template-columns:210px minmax(500px,1fr)}.rightbar{display:none}.feed{grid-template-columns:repeat(2,minmax(0,1fr))}.adrow{grid-column:span 2}.moods{grid-template-columns:repeat(4,1fr)}}@media(max-width:820px){.layout{display:block;padding:8px 10px 90px}.sidebar{display:none}.topbar{position:sticky;top:0;z-index:10;padding:8px 0;background:#090a18eF}.round{display:none}.say{padding:12px}.hero{height:130px;padding:20px}.hero h2{font-size:27px}.moods{display:flex;overflow:auto;padding-bottom:4px}.mood{min-width:105px}.feed{grid-template-columns:1fr 1fr;gap:9px}.post,.post.tall{min-height:230px}.quote{font-size:15px}.adrow{grid-column:span 2;gap:9px}.ad{height:90px}.filters{overflow:auto}.filter{white-space:nowrap}.mobile-nav{position:fixed;bottom:0;left:0;right:0;display:flex;justify-content:space-around;padding:10px env(safe-area-inset-right) calc(10px + env(safe-area-inset-bottom)) env(safe-area-inset-left);background:#0c0d1cf2;border-top:1px solid #2c2f50;z-index:15}.mobile-nav button{border:0;background:transparent;color:#c7c9df;font-size:21px}.mobile-nav span{display:block;font-size:10px;margin-top:3px}.brand-mini{display:flex}.search{padding:12px}.section-head h2{font-size:19px}}@media(max-width:470px){.hero p{font-size:13px}.mood{min-width:96px;height:95px}.post{min-height:215px}.post-content{padding:12px}.tag{font-size:10px}.quote{font-size:14px}.post-actions{gap:8px;font-size:11px}.adrow{grid-template-columns:1fr 1fr}.ad{font-size:9px}}
