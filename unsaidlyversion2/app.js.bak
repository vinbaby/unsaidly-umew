const moods=['lonely','love','angry','happy','confused','secret','lovely'];
const labels={lonely:'Lonely',love:'Love',angry:'Angry',happy:'Happy',confused:'Confused',secret:'Secret',lovely:'Lovely'};
const demo=[
 ['love','Tớ từng nghĩ mình không xứng đáng được yêu... cho đến khi có một người ở lại. 💗','love',324,52],
 ['lonely','Xung quanh nhiều người, nhưng sao vẫn thấy một mình...','lonely',217,47],
 ['happy','Hôm nay không có gì đặc biệt, nhưng tớ vẫn thấy vui. 💛','happy',187,29],
 ['secret','Có những điều... chỉ có thể giấu ở đây.','secret',192,18],
 ['confused','Tớ không biết mình nhớ cậu, hay chỉ nhớ cảm giác khi ở bên cậu...','confused',176,34],
 ['lovely','Những điều nhỏ bé cũng có thể làm tớ yêu đời hơn...','lovely',159,23],
 ['angry','Tớ không giận cậu... Tớ chỉ thấy tổn thương. 🔥','angry',192,41],
 ['secret','This is the one thing nobody around me knows.','secret',102,16],
 ['lonely','I smile a lot, but inside is a storm.','lonely',248,32]
];
let anon=localStorage.getItem('unsaidly_anon_id');if(!anon){anon=crypto.randomUUID();localStorage.setItem('unsaidly_anon_id',anon)}
function posts(){let x=JSON.parse(localStorage.getItem('unsaidly_v2_posts')||'null');if(!x){x=demo.map((d,i)=>({id:'d'+i,mood:d[0],content:d[1],image:d[2],likes:d[3],replies:d[4],created:Date.now()-i*3600000,anon_id:'demo'}));localStorage.setItem('unsaidly_v2_posts',JSON.stringify(x))}return x}function save(x){localStorage.setItem('unsaidly_v2_posts',JSON.stringify(x))}
let state={filter:'for',page:'home'};
const img=n=>`assets/${n}.jpg`;
function moodCards(){return `<div class="moods">${moods.map(m=>`<button class="mood" style="--img:url('${img(m)}')" onclick="filterMood('${m}')"><span>${labels[m]}</span></button>`).join('')}</div>`}
function postCard(p,i){return `<article class="post ${i%5===1?'tall':''}"><div class="post-bg" style="background-image:url('${img(p.image||p.mood)}')"></div><div class="post-shade"></div><div class="post-content"><span class="tag"># ${labels[p.mood]}</span><div class="quote">“${escapeHtml(p.content)}”</div><div class="post-actions"><button onclick="meToo('${p.id}')">💗 ${p.likes}</button><button onclick="openReplies('${p.id}')">💬 ${p.replies}</button><button onclick="openMenu('${p.id}')">•••</button></div></div></article>`}
function render(){let all=posts();let list=state.mood?all.filter(p=>p.mood===state.mood):all;let sort=state.filter==='trend'?[...list].sort((a,b)=>b.likes-a.likes):state.filter==='new'?[...list].sort((a,b)=>b.created-a.created):list;let feed='';sort.forEach((p,i)=>{feed+=postCard(p,i);if(i===3)feed+=`<div class="adrow"><div class="ad">ADVERTISEMENT — BANNER 1</div><div class="ad">ADVERTISEMENT — BANNER 2</div></div>`});document.querySelector('#app').innerHTML=`<div class="layout"><aside class="sidebar"><div class="brand"><img src="assets/lovely.jpg"><div><h1>UNSAIDLY</h1><p>Say it. Let it go. 💗</p></div></div><nav class="nav"><button class="active" onclick="home()"><span class="ico">🏠</span>Trang chủ</button><button onclick="setFilter('trend')"><span class="ico">🔥</span>Thịnh hành</button><button onclick="setFilter('new')"><span class="ico">🕒</span>Mới nhất</button><button onclick="randomPost()"><span class="ico">🎲</span>Ngẫu nhiên</button><button onclick="showMood()"><span class="ico">🌐</span>Mood thế giới</button></nav><div class="nav-title">Khám phá</div><nav class="nav"><button onclick="filterMood('love')">💗 Tình yêu</button><button onclick="filterMood('happy')">🎓 Học tập</button><button onclick="filterMood('angry')">💼 Công việc</button><button onclick="filterMood('lovely')">🏠 Gia đình</button><button onclick="filterMood('lonely')">👥 Bạn bè</button></nav><div class="mini-mascot"><img src="assets/sidebar.jpg"><small>© 2026 Unsaidly<br>Made with ♡ and UMEW</small></div></aside><main><div class="topbar"><input class="search" placeholder="🔎  Tìm cảm xúc, từ khóa, hashtag..." oninput="searchPosts(this.value)"><button class="round" onclick="randomPost()">🎲 Surprise me</button><button class="round">🔔</button><button class="say" onclick="openComposer()">✎ + Viết gì đó...</button></div><section class="hero"><h2>Anonymous thoughts.</h2><p>No profile. No pressure.<br>Just you and what you need to say. 💗</p></section>${moodCards()}<div class="section-head"><h2>${state.mood?'# '+labels[state.mood]:'Explore feelings'}</h2><div class="filters"><button class="filter ${state.filter==='for'?'active':''}" onclick="setFilter('for')">Dành cho bạn</button><button class="filter ${state.filter==='trend'?'active':''}" onclick="setFilter('trend')">🔥 Thịnh hành</button><button class="filter ${state.filter==='new'?'active':''}" onclick="setFilter('new')">🕒 Mới nhất</button></div></div><section class="feed">${feed||'<div class="panel">Chưa có bài phù hợp.</div>'}</section></main>${rightbar()}<div class="mobile-nav"><button onclick="home()">🏠<span>Home</span></button><button onclick="randomPost()">🎲<span>Random</span></button><button onclick="openComposer()">➕<span>Viết</span></button><button onclick="showMood()">🌐<span>Mood</span></button></div></div>`}
function rightbar(){let counts={};posts().forEach(p=>counts[p.mood]=(counts[p.mood]||0)+1);let top=moods.sort((a,b)=>(counts[b]||0)-(counts[a]||0)).slice(0,5);return `<aside class="rightbar"><section class="panel"><h3>🔥 Thịnh hành <span style="float:right;color:#9ea3c0;font-size:12px">Xem tất cả</span></h3>${top.map((m,i)=>`<div class="trend"><b>${i+1}</b><img src="${img(m)}"><b># ${labels[m]}</b><small>${(counts[m]||0)*843+300} bài</small></div>`).join('')}</section><section class="panel talk"><h3>💬 UMEW nói...</h3><div class="bubble">“Hãy cứ nói ra, ở đây không ai phán xét.”</div></section><section class="panel"><h3>📊 Cảm xúc thế giới</h3><div class="chart"><div class="donut"></div><div class="legend"><span class="dot" style="background:#ff5ab5"></span>Love 34%<br><span class="dot" style="background:#8a70ff"></span>Lonely 22%<br><span class="dot" style="background:#69b7df"></span>Sad 18%<br><span class="dot" style="background:#6c5aa8"></span>Angry 12%<br><span class="dot" style="background:#f3a444"></span>Secret 8%<br><span class="dot" style="background:#ffe04b"></span>Happy 6%</div></div></section></aside>`}
function setFilter(x){state.filter=x;state.mood=null;render()}function filterMood(m){state.mood=m;state.filter='for';render()}function home(){state.mood=null;state.filter='for';render()}function meToo(id){let p=posts(),x=p.find(a=>a.id===id);x.likes++;save(p);render()}function randomPost(){let p=posts();let x=p[Math.floor(Math.random()*p.length)];state.mood=x.mood;state.filter='for';render();setTimeout(()=>document.querySelector('.post')?.scrollIntoView({behavior:'smooth',block:'center'}),80)}function searchPosts(q){if(!q.trim())return render();let all=posts().filter(p=>(p.content+' '+p.mood).toLowerCase().includes(q.toLowerCase()));document.querySelector('.feed').innerHTML=all.map(postCard).join('')||'<div class="panel">Không tìm thấy tâm sự phù hợp.</div>'}
function modal(html){document.body.insertAdjacentHTML('beforeend',`<div class="modal-back" id="modal"><div class="modal">${html}</div></div>`)}function closeModal(){document.querySelector('#modal')?.remove()}function openComposer(){modal(`<h2>✎ Say it here.</h2><p style="color:#9ca1bd">Nobody needs to know who you are.</p><textarea id="newText" class="textarea" maxlength="500" placeholder="What's something you can't say out loud?"></textarea><div style="margin-top:12px">${moods.map(m=>`<button class="filter" onclick="chooseMood('${m}')">${labels[m]}</button>`).join(' ')}</div><div class="modal-actions"><button class="primary" onclick="submitPost()">POST ANONYMOUSLY 🖤</button><button class="ghost" onclick="closeModal()">Hủy</button></div></div>`);window.chosenMood='lonely'}function chooseMood(m){window.chosenMood=m;document.querySelectorAll('#modal .filter').forEach(b=>b.classList.toggle('active',b.textContent===labels[m]))}function submitPost(){let t=document.querySelector('#newText').value.trim();if(!t)return alert('Viết điều bạn muốn nói trước đã 🖤');let p=posts();p.unshift({id:crypto.randomUUID(),mood:window.chosenMood||'lonely',content:t,image:window.chosenMood||'lonely',likes:0,replies:0,created:Date.now(),anon_id:anon});save(p);closeModal();home()}function openReplies(id){let p=posts().find(x=>x.id===id);let rs=JSON.parse(localStorage.getItem('unsaidly_v2_replies')||'[]').filter(x=>x.post_id===id);modal(`<h2>💬 Replies</h2><p style="color:#d9dbea">“${escapeHtml(p.content)}”</p>${rs.map(r=>`<div class="reply">${escapeHtml(r.text)}<br><small style="color:#8f94b2">Anonymous</small></div>`).join('')||'<p style="color:#8f94b2">Chưa có reply nào.</p>'}<textarea id="replyText" class="textarea" placeholder="Nói gì đó một cách ẩn danh..."></textarea><div class="modal-actions"><button class="primary" onclick="submitReply('${id}')">Reply anonymously</button><button class="ghost" onclick="closeModal()">Đóng</button></div></div>`)}function submitReply(id){let t=document.querySelector('#replyText').value.trim();if(!t)return;let r=JSON.parse(localStorage.getItem('unsaidly_v2_replies')||'[]');r.push({post_id:id,text:t});localStorage.setItem('unsaidly_v2_replies',JSON.stringify(r));let p=posts(),x=p.find(a=>a.id===id);x.replies++;save(p);closeModal();render()}function openMenu(id){modal(`<h2>••• Tùy chọn</h2><button class="ghost" onclick="alert('Report đã được ghi nhận trong Phase 2 backend');closeModal()">🚩 Report post</button><div class="modal-actions"><button class="ghost" onclick="closeModal()">Đóng</button></div>`)}function showMood(){document.querySelector('.rightbar .panel:last-child')?.scrollIntoView({behavior:'smooth'});alert('Mood of the world đang hiển thị ở bảng bên phải 🌐')}function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
render();
